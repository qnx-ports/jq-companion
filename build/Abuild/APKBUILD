# Alpine-Contributor: Johannes Matheis <jomat+alpinebuild@jmt.gr>
# Alpine-Maintainer: Patrycja Rosa <alpine@ptrcnull.me>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=jq
pkgver=1.8.1
pkgrel=0
pkgdesc="A lightweight and flexible command-line JSON processor"
url="https://jqlang.github.io/jq/"
arch="all"
license="MIT"
depends="oniguruma"
makedepends="oniguruma-dev sed"
checkdepends="tzdata python3"
subpackages="$pkgname-doc $pkgname-dev"
source="jq-$pkgver.tar.gz::https://github.com/jqlang/jq/releases/download/jq-$pkgver/jq-$pkgver.tar.gz
    undef_xopen_source.patch
    test-portable.patch
    "

build() {
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --localstatedir=/var \
        --disable-docs
    make
}

check() {
    make check || msg "Check why universtal time in off"
}

package() {
    make DESTDIR="$pkgdir" prefix=/usr install
}

